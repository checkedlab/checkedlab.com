{
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/pets",
      "destination": "/pet/",
      "permanent": true
    },
    {
      "source": "/pets/",
      "destination": "/pet/",
      "permanent": true
    }
  ]
}
